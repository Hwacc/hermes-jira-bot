# Hermes Jira Bot — 环境变量模板
# 复制为 ~/.hermes/.env 并填入实际值
# 或运行 install.sh 交互式配置

# ============================================
# Jira 凭证（必填）
# ============================================
# API Token: https://id.atlassian.com/manage-profile/security/api-tokens
# Cloud ID:  https://<your-site>.atlassian.net/secure/admin/cloudid
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token-here
JIRA_CLOUD_ID=your-cloud-id-here

# ============================================
# Cloudflare Pages（HTML 日报必需）
# ============================================
# 如果只用纯文本日报（fetch_digest.py），可跳过。
# API Token 创建: https://dash.cloudflare.com/profile/api-tokens
#   权限: Account → Cloudflare Pages → Edit
# Account ID: https://dash.cloudflare.com → 右侧 API 栏
# CLOUDFLARE_API_TOKEN=your-cf-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cf-account-id

# ============================================
# 可选配置
# ============================================
# 日报 cron 调度（安装脚本 quiet 模式 / 覆盖默认每天 09:00）
# 支持友好时间或标准 cron，例如: 9:00 / 09:30 / 0 9 * * *
# JIRA_DIGEST_CRON=0 9 * * *

# 日报投递目标（可选，默认 origin）
# 合法值: origin / local / telegram / discord / signal / <platform>:<chat_id>
# 例: qqbot:123456789 或 telegram:-1001234567890
# JIRA_DELIVER=

# Jira 站点 URL（用于报表中的 issue 链接）
# JIRA_SITE_URL=https://<your-site>.atlassian.net

# Account ID 过滤（默认 currentUser()）
# JIRA_ASSIGNEE=

# 报表中显示的用户名（留空自动从 Jira API 获取）
# JIRA_USER_DISPLAY=

# ============================================
# Bitbucket（/fix 建 PR 必需；provider=bitbucket）
# ============================================
# App Password: Bitbucket → Personal settings → App passwords
# 权限至少: Repositories Read + Pull requests Write
# BITBUCKET_USERNAME=your-bitbucket-username
# BITBUCKET_APP_PASSWORD=your-app-password

# ============================================
# Bitbucket Webhook 薄适配层（只转发 Hermes；Jira 由 Hermes 写）
# ============================================
# 启动: python webhook/bitbucket_adapter.py --host 127.0.0.1 --port 8787
# 详见 webhook/README.md
# 适配层机器：不必配置 JIRA_*（Hermes 所在机需要 JIRA_*）
# Bitbucket webhook：Cloudflare Tunnel → adapter(8787) → Hermes webhook(8644)
# BITBUCKET_WEBHOOK_SECRET=shared-secret-with-bitbucket-repo-webhook
# HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/bitbucket-pr-merged
# HERMES_WEBHOOK_SECRET=same-as-hermes-route-secret
# ADAPTER_HOST=127.0.0.1
# ADAPTER_PORT=8787
# ADAPTER_STATE_DIR=
# ADAPTER_HERMES_RETRIES=3
# ADAPTER_RETRY_BACKOFF_SEC=1.0
# Tunnel: cloudflared tunnel --url http://127.0.0.1:8787
# Bitbucket URL: https://<tunnel-host>/bitbucket

