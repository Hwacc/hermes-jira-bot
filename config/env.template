# Hermes Jira Bot — 环境变量模板
# 复制为 ~/.hermes/.env 并填入实际值
# 或运行 install.sh 交互式配置

# ============================================
# Jira API Token（必填）
# ============================================
# 获取方式：https://id.atlassian.com/manage-profile/security/api-tokens
# 点击 "Create API token" → 起个名字 → 复制 token
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token-here

# ============================================
# Jira Cloud ID（必填）
# ============================================
# 获取方式：https://<your-site>.atlassian.net/secure/admin/cloudid
JIRA_CLOUD_ID=your-cloud-id-here
