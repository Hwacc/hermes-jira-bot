# Hermes Jira Bot — 环境变量模板
# 复制为 ~/.hermes/.env 并填入实际值
# 或运行 install.sh 交互式配置

# ============================================
# Jira 凭证（必填）
# ============================================
# API Token: https://id.atlassian.com/manage-profile/security/api-tokens
# Cloud ID:  https://<your-site>.atlassian.net/secure/admin/cloudid
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token-here
JIRA_CLOUD_ID=your-cloud-id-here

# ============================================
# 可选配置
# ============================================
# Jira 站点 URL（用于报表中的 issue 链接）
# JIRA_SITE_URL=https://<your-site>.atlassian.net

# Account ID 过滤（默认 currentUser()）
# JIRA_ASSIGNEE=

# 报表中显示的用户名（默认 "User"）
# JIRA_USER_DISPLAY=Hwacc

# Cloudflare account ID（跳过自动发现）
# CLOUDFLARE_ACCOUNT_ID=
